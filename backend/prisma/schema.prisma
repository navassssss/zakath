generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  MAHALL_ADMIN
  USER
}

enum EligibilityStatus {
  PENDING
  MORE_INFORMATION_REQUIRED
  APPROVED
  REJECTED
}

model User {
  id                 String                  @id @default(uuid())
  email              String                  @unique
  name               String?
  avatarUrl          String?
  googleId           String?                 @unique
  passwordHash       String?
  role               UserRole                @default(USER)
  mahallId           String?
  mahall             Mahall?                 @relation(fields: [mahallId], references: [id], onDelete: Restrict)
  eligibilityCase    EligibilityCase?        @relation("EligibilityApplicant")
  onboardingProfile  OnboardingProfile?
  eligibilityReviews EligibilityCase[]       @relation("EligibilityReviewer")
  zakatHandovers     ZakatHandover[]
  contributions      CommitteeContribution[]
  routePayments      RoutePayment[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([mahallId])
}

model OnboardingProfile {
  userId                String   @id
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locality              String
  postalCode            String
  householdSize         Int
  monthlyIncomePaise    Int
  monthlyExpensesPaise  Int
  completedAt           DateTime @default(now())
}

model PendingEmailRegistration {
  email     String   @id
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Mahall {
  id            String                  @id @default(uuid())
  name          String
  locality      String
  members       User[]
  assignedCases EligibilityCase[]
  contributions CommitteeContribution[]
  allocations   CommitteeAllocation[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
}

model EligibilityCase {
  id                    String            @id @default(uuid())
  applicantId           String            @unique
  applicant             User              @relation("EligibilityApplicant", fields: [applicantId], references: [id], onDelete: Restrict)
  reviewingMahallId     String?
  reviewingMahall       Mahall?           @relation(fields: [reviewingMahallId], references: [id], onDelete: Restrict)
  status                EligibilityStatus @default(PENDING)
  locality              String
  postalCode            String
  householdSize         Int
  monthlyIncomePaise    Int
  monthlyExpensesPaise  Int
  additionalInformation String?
  applicantResponse     String?
  requestCategory       String?
  requestReason         String?
  requestedPaise        Int?
  shareIncome           Boolean           @default(false)
  verificationDocument EligibilityDocument?
  routeAccountId        String?
  routePayments         RoutePayment[]
  reviewedById          String?
  reviewedBy            User?             @relation("EligibilityReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt            DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  handovers             ZakatHandover[]
  allocations           CommitteeAllocation[]

  @@index([reviewingMahallId, status])
  @@index([postalCode, status])
  @@index([reviewedById])
}

model EligibilityDocument {
  caseId      String          @id
  eligibility EligibilityCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  contentType String
  content     Bytes
}

model RoutePayment {
  id              String          @id @default(uuid())
  giverId         String
  giver           User            @relation(fields: [giverId], references: [id], onDelete: Restrict)
  caseId          String
  eligibility     EligibilityCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  recipientAccount String
  amountPaise     Int
  providerOrderId String?         @unique
  status          String          @default("PENDING")
  receivedPaise   Int             @default(0)
  receivedAt      DateTime?
  createdAt       DateTime        @default(now())

  @@index([giverId, createdAt])
  @@index([caseId, receivedAt])
}

model CommitteeAllocation {
  id          String          @id @default(uuid())
  mahallId    String?
  mahall      Mahall?         @relation(fields: [mahallId], references: [id], onDelete: Restrict)
  caseId      String
  eligibility EligibilityCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  amountPaise Int
  createdAt   DateTime        @default(now())
  confirmedAt DateTime?

  @@index([mahallId])
  @@index([caseId, confirmedAt])
}

model ZakatHandover {
  id          String          @id @default(uuid())
  giverId     String
  giver       User            @relation(fields: [giverId], references: [id], onDelete: Restrict)
  caseId      String
  eligibility EligibilityCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  amountPaise Int
  createdAt   DateTime        @default(now())
  confirmedAt DateTime?

  @@index([giverId, createdAt])
  @@index([caseId, confirmedAt])
}

model CommitteeContribution {
  id          String    @id @default(uuid())
  giverId     String
  giver       User      @relation(fields: [giverId], references: [id], onDelete: Restrict)
  mahallId    String?
  mahall      Mahall?   @relation(fields: [mahallId], references: [id], onDelete: Restrict)
  amountPaise Int
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  @@index([giverId, createdAt])
  @@index([mahallId, confirmedAt])
}
